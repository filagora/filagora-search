{
    "name": "filagora/filagora-search",
    "description": "Engine-agnostic search for Filagora: a SearchEngine contract, Meilisearch and database engines, indexing and health commands.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filagora",
        "search"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filagora/filagora-core": "^0.2.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Search\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Search\\SearchServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
